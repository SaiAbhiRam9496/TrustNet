{
  "manifest_version": 3,
  "name": "TrustNet Fact-Checker",
  "version": "1.0.0",
  "description": "Evidence-first AI credibility analysis and fact-checking browser extension.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TrustNet Fact-Checker"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
